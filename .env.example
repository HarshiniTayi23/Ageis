# Copy to .env (make setup does this). .env is git-ignored. Never commit real secrets.

# Aegis
AEGIS_PASSPHRASE=dev-only-change-me
AEGIS_REPO=./aegis-repo
AEGIS_BUCKET=aegis-vault
# Default COMPLIANCE retention on the vault bucket. Keep it short in dev:
# objects truly cannot be deleted before this expires.
AEGIS_RETENTION_DAYS=1

# MinIO (local S3)
MINIO_ROOT_USER=aegis-admin
MINIO_ROOT_PASSWORD=dev-only-change-me-too
AEGIS_S3_ENDPOINT=http://localhost:9000

# Postgres (sample company database for the AI-agent scenarios)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=dev-only-postgres
POSTGRES_DB=company
